rules_version = '2';

// Reguły dostępu do danych ClimbPhone.
// Wklej całość w konsoli Firebase: Firestore Database → Rules → Publish.
//
// Każdy użytkownik widzi i zmienia wyłącznie własne dane: users/{jego uid}/...
// Nic więcej nie jest dostępne – ani dla innych kont, ani bez logowania.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
